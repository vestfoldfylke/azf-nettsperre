{
  "name": "azf-nettsperre",
  "version": "3.0.34",
  "description": "Azure Functions for nettsperre",
  "type": "module",
  "main": "dist/src/functions/*.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "biome check && tsc --noEmit --project tsconfig.json",
    "lint:fix": "biome check --write",
    "build": "tsc --project tsconfig.json",
    "watch": "tsc -w",
    "clean": "rm -rf dist",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "test": "npm run lint"
  },
  "dependencies": {
    "@azure/functions": "^4.17.1",
    "@azure/msal-node": "^7.2.2",
    "@vestfoldfylke/loglady": "^2.1.0",
    "mongodb": "^7.9.0",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
